# --- Cómo se publica el AVA -------------------------------------------------
# Vacío  = está detrás de un túnel (Tailscale Funnel) y no tiene dominio propio;
#          Caddy escucha solo en 127.0.0.1:8081 y el TLS lo pone el túnel.
# Con valor = servidor público (Hetzner, GCP...); Caddy toma 80 y 443 y saca el
#          certificado él mismo para este nombre. El registro A del dominio TIENE
#          que apuntar ya a esta máquina, o Let's Encrypt no puede validarlo.
# Es lo único que hay que cambiar al mudar el AVA de máquina.
AVA_DOMINIO=
# El Moodle que puede embeber el AVA dentro de un marco.
AVA_MOODLE=https://lms.uis.edu.co

# Copia este archivo a .env y rellena los valores. .env NO se versiona.
# En la VM y en local, docker-compose lee estas variables.

# --- Base de datos (postgres-database + backend api_go) ---
DB_USER=ava
DB_PASSWORD=cambia-esta-clave
DB_NAME=ava
# Dentro de docker-compose el backend llega a postgres por el nombre del servicio.
DB_HOST=postgres-database
DB_PORT=5432

# --- JupyterHub ---
# Cifra el auth_state en la BD del Hub. Generar con: openssl rand -hex 32
JUPYTERHUB_CRYPT_KEY=genera-una-con-openssl-rand-hex-32

# Credenciales del consumer LTI de Moodle (rotar respecto a los de desarrollo).
LTI_CLIENT_KEY=moodle-llave-publica
LTI_CLIENT_SECRET=cambia-este-secreto

# "true" para que Jupyter envíe la telemetría al backend; "false" = modo
# simulación (solo la imprime en el log del contenedor del alumno).
# Déjalo en "true" salvo que estés depurando: con "false" el alumno trabaja
# normal, el navegador recibe 200 y no se guarda absolutamente nada.
ENVIAR_AL_BACKEND=true

# Base del backend a la que el puente de métricas reenvía los eventos.
# (metrics_bridge le agrega /api/exercises/attempts o /api/cuadernillos/ratings.)
STUDENT_METRICS_API_BASE=http://api_go:8080

# --- Tutor IA ---
# Dos claves de Gemini = dos clientes en paralelo (pkg/tutor/clientInit.go).
# Sirven tanto las de AI Studio ("AIza...") como las de Google Cloud ("AQ...").
# Si faltan o son inválidas, la API arranca igual y el tutor responde 503.
GOOGLE_API_KEY_1=pon-aqui-tu-api-key-de-gemini
GOOGLE_API_KEY_2=pon-aqui-otra-api-key-de-gemini

# Nombre con el que el tutor se presenta al estudiante.
TUTOR_ALIAS=Ava

# Modelo de Gemini. Google retira modelos: si la API responde 404 diciendo que
# el modelo "is no longer available", se cambia aquí sin recompilar.
# Para ver los disponibles con tu clave:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=TU_CLAVE"
TUTOR_MODELO=gemini-3.5-flash

# "false" apaga el tutor para todo el curso (el panel ni siquiera se dibuja).
# Un cuadernillo puede apagarlo por su cuenta con
# notebook.metadata.tutor_ia = {"enabled": false}
TUTOR_IA_HABILITADO=true

# Preguntas que cada estudiante puede hacer POR CUADERNILLO. Las cuenta
# tutor_bridge.py dentro del contenedor del alumno, no el navegador.
TUTOR_MAX_PREGUNTAS=5
METRICS_API_TOKEN=
METRICS_TOKEN_SECRET=

# --- Servicio de intercambio (nbexchange) ---
# Con este token el Hub registra el servicio y el servicio le pregunta al Hub
# quien es cada usuario. Va en los dos contenedores (compose lo reparte).
# Generar: openssl rand -hex 32. Rotarlo: ver NBEXCHANGE.md.
NBEXCHANGE_API_TOKEN=
