# La versión va FIJA, y hace falta que lo esté.
#
# Estaba como `:latest` y el 2026-09-21 una reconstrucción rutinaria se trajo
# JupyterHub 6.0.1 sobre una base de estado creada por la 5.5.1. El Hub se negó
# a arrancar —"Found database schema version 4621fec11365 != f460b0348206"— y
# entró en bucle de reinicio, dejando el AVA sin login. No lo provocó ningún
# cambio del AVA: le habría pasado a cualquier `docker compose build`.
#
# Subir de versión mayor es una decisión aparte: hay que comprobar antes que
# DockerSpawner, el autenticador LTI y el culler siguen funcionando, y correr
# `jupyterhub upgrade-db` sobre el volumen hub_estado con respaldo delante.
FROM jupyterhub/jupyterhub:5.5.1

# Instalar los plugins necesarios directamente en el entorno virtual de JupyterHub (/srv/venv)
RUN /srv/venv/bin/pip install --no-cache-dir \
    dockerspawner \
    jupyterhub-ltiauthenticator \
    httpx \
    jupyterhub-idle-culler